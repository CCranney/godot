#!/usr/bin/env python
from misc.utility.scons_hints import *

from platform_ios_builders import generate_bundle
from SCons.Script import Glob

from platform_methods import combine_libs_apple_embedded
from library_type_sources import select_sources_for_library_type, setup_swift_builder_for_executables

Import("env")

swift_files = Glob("*.swift")
swift_file_names = list(map(lambda f: f.name, swift_files))

mm_files = Glob("*.mm")
mm_file_names = list(map(lambda f: f.name, mm_files))
executable_only_mm_names = {
    "device_metrics.mm",
    "display_layer_ios.mm",
    "display_server_ios.mm",
    "godot_view_ios.mm",
    "main_ios.mm",
}
mm_file_names = select_sources_for_library_type(mm_file_names, env["library_type"], executable_only=executable_only_mm_names)

env_ios = env.Clone()

# Configure Swift builder
additional_swift_file_names = ["../../drivers/apple_embedded/godot_swiftui_view_controller.swift"]
apple_platform = env["APPLE_PLATFORM"]
sdk_path = env["APPLE_SDK_PATH"]
current_path = Dir(".").abspath
bridging_header_filename = "bridging_header_ios.h"
# The Swift sources are compiled together into a single object that's linked into the library.
swift_module = setup_swift_builder_for_executables(
    env_ios,
    apple_platform,
    sdk_path,
    current_path,
    bridging_header_filename,
    swift_file_names + additional_swift_file_names,
)

# Enable module support
env_ios.Append(CCFLAGS=["-fmodules", "-fcxx-modules"])

ios_lib = env_ios.add_library("ios", mm_file_names + list(swift_module))
if "LIBS_EXTERNAL" in env_ios:
    env_ios.Depends(ios_lib, env_ios["LIBS_EXTERNAL"])

# Build the Swift->ObjC interop header before any ObjC++ source that #imports it.
if swift_module:
    env_ios.Depends(ios_lib, env_ios["SWIFT_OBJC_HEADER_TARGET"])

combine_command = env_ios.CommandNoCache(
    "#bin/libgodot" + env_ios["LIBSUFFIX"], [ios_lib] + env_ios["LIBS"], env.Run(combine_libs_apple_embedded)
)

if env["generate_bundle"]:
    env.AlwaysBuild(env.CommandNoCache("generate_bundle", combine_command, env.Run(generate_bundle)))
